<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dependency-free check runner (same style as the Presentation and TMDB runners).
       Targets plain net10.0 so it also runs where WPF is unavailable. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ParallaxStudio.Infrastructure.Tests</RootNamespace>
    <AssemblyName>ParallaxStudio.Infrastructure.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ParallaxStudio.Core\ParallaxStudio.Core.csproj" />
    <ProjectReference Include="..\..\src\ParallaxStudio.Infrastructure\ParallaxStudio.Infrastructure.csproj" />
    <!-- Built and copied beside the runner; launched as the DVD host executable. -->
    <ProjectReference Include="..\ParallaxStudio.DvdHostStub\ParallaxStudio.DvdHostStub.csproj" />
  </ItemGroup>
</Project>
