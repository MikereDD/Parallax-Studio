<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ParallaxStudio.DvdPlaybackHost</RootNamespace>
    <AssemblyName>ParallaxStudio.DvdPlaybackHost</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.5550</FileVersion>
    <InformationalVersion>1.0-dev.5.5.5</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ParallaxStudio.Core\ParallaxStudio.Core.csproj" />
    <ProjectReference Include="..\ParallaxStudio.Infrastructure\ParallaxStudio.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\native\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\native\libmpv-2.dll')" />
    <Content Include="..\..\native\libdvdcss-2.dll" Link="libdvdcss-2.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\native\libdvdcss-2.dll')" />
  </ItemGroup>
</Project>
