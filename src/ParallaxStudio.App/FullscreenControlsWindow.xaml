<Window x:Class="ParallaxStudio.App.FullscreenControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Width="960" Height="104"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False" KeyDown="FullscreenControls_KeyDown">
    <Border Style="{StaticResource TransportBorder}" Padding="{DynamicResource StudioFloatingTransportPadding}" Margin="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="" Style="{StaticResource IconButton}" Command="{Binding SeekBackCommand}" ToolTip="{Binding SeekBackToolTip}" />
                <Button Content="{Binding PlayPauseGlyph}" Style="{StaticResource PlayTransportButton}" Command="{Binding PlayPauseCommand}" Margin="8,0" ToolTip="Play or pause" AutomationProperties.Name="{Binding PlayPauseText}" />
                <Button Content="" Style="{StaticResource IconButton}" Command="{Binding SeekForwardCommand}" ToolTip="{Binding SeekForwardToolTip}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                <Grid Margin="1,0,1,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PositionText}" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{Binding NowPlayingTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="10,0" />
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11" />
                </Grid>
                <Slider x:Name="FullscreenTimelineSlider"
                        Minimum="0" Maximum="{Binding DurationSeconds}"
                        Value="{Binding ScrubPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PreviewMouseLeftButtonDown="TimelineSlider_PreviewMouseLeftButtonDown"
                        PreviewKeyDown="TimelineSlider_PreviewKeyDown"
                        KeyUp="TimelineSlider_KeyUp"
                        LostKeyboardFocus="TimelineSlider_LostKeyboardFocus"
                        primitives:Thumb.DragStarted="TimelineSlider_DragStarted"
                        primitives:Thumb.DragCompleted="TimelineSlider_DragCompleted"
                        ToolTip="Seek" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding MuteGlyph}" Style="{StaticResource IconButton}" Command="{Binding ToggleMuteCommand}" ToolTip="Mute or unmute" Margin="0,0,8,0" />
                <Slider Width="82" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" ToolTip="Volume" />
                <Button Content="" Style="{StaticResource IconButton}" Command="{Binding ToggleFullscreenCommand}" ToolTip="Exit fullscreen" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
