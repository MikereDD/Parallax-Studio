<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ParallaxStudio.App</RootNamespace>
    <AssemblyName>ParallaxStudio.App</AssemblyName>
    <ApplicationIcon>Assets\parallax-studio.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.5531</FileVersion>
    <InformationalVersion>1.0-dev.5.5.3.1</InformationalVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ParallaxStudio.Core\ParallaxStudio.Core.csproj" />
    <ProjectReference Include="..\ParallaxStudio.Infrastructure\ParallaxStudio.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\parallax-studio-icon-256.png" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\native')">
    <Content Include="..\..\native\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
