                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="" Style="{StaticResource IconButton}" Command="{Binding SeekBackCommand}" ToolTip="{Binding SeekBackToolTip}" AutomationProperties.Name="{Binding SeekBackToolTip}" />
                        <Button Content="{Binding PlayPauseGlyph}" Style="{StaticResource PrimaryButton}" Command="{Binding PlayPauseCommand}" Width="{DynamicResource StudioPlayButtonWidth}" Height="{DynamicResource StudioPlayButtonHeight}" Margin="8,0" FontFamily="Segoe Fluent Icons" FontSize="19" Padding="0" ToolTip="Play or pause (Space)" AutomationProperties.Name="{Binding PlayPauseText}" />
                        <Button Content="" Style="{StaticResource IconButton}" Command="{Binding SeekForwardCommand}" ToolTip="{Binding SeekForwardToolTip}" AutomationProperties.Name="{Binding SeekForwardToolTip}" />
                        <Button Content="" Style="{StaticResource IconButton}" Command="{Binding StopCommand}" ToolTip="Stop playback" AutomationProperties.Name="Stop playback" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                        <Grid Margin="1,0,1,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PositionText}" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding NowPlayingTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="12,0" />
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="12" />
                        </Grid>
                        <Slider x:Name="TimelineSlider" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding ScrubPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewMouseLeftButtonDown="TimelineSlider_PreviewMouseLeftButtonDown" PreviewKeyDown="TimelineSlider_PreviewKeyDown" KeyUp="TimelineSlider_KeyUp" LostKeyboardFocus="TimelineSlider_LostKeyboardFocus" primitives:Thumb.DragStarted="TimelineSlider_DragStarted" primitives:Thumb.DragCompleted="TimelineSlider_DragCompleted" ToolTip="Click or drag to seek" AutomationProperties.Name="Playback position" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding MuteGlyph}" Style="{StaticResource IconButton}" Command="{Binding ToggleMuteCommand}" ToolTip="Mute or unmute (M)" AutomationProperties.Name="Mute or unmute" Margin="0,0,8,0" />
                        <Slider Width="90" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" ToolTip="Volume" AutomationProperties.Name="Volume" />
                        <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Width="38" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="{DynamicResource StudioTransportStatusMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="1" Text="SPACE  Play / pause     ← →  Seek     F  Fullscreen" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
