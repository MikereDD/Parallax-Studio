<Window x:Class="ParallaxStudio.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" xmlns:interop="clr-namespace:ParallaxStudio.App.Interop" xmlns:services="clr-namespace:ParallaxStudio.App.Services" Title="Parallax Studio" Width="1380" Height="860" MinWidth="1020" MinHeight="680" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" KeyDown="Window_KeyDown" Loaded="Window_Loaded" Closing="Window_Closing" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TitleBarIconPicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <!-- Inset the stock chevron so it no longer crowds the right outline. -->
            <Setter Property="Padding" Value="0,0,6,0" />
            <!-- Keep the selected string available to automation/keyboard behavior, but let the title bar show only the icon. -->
            <Setter Property="Foreground" Value="Transparent" />
        </Style>
        <Style x:Key="CinemaChrome" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MediaItemCard" TargetType="Border" BasedOn="{StaticResource InsetBorder}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CornerRadius" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="TrackTemplate">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource MediaItemCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{Binding PrimaryText}" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SecondaryText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SecondaryText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Border x:Name="StateBadge" Grid.Column="1" Style="{StaticResource AccentBadgeBorder}" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource AccentBadgeText}" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="StateBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource ShellBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Lighting stays behind the shell. The native video host keeps its opaque surface. -->
        <Border Grid.RowSpan="3" Background="{DynamicResource AtmosphereBrush}" IsHitTestVisible="False" />
        <Border Grid.Row="0" Style="{StaticResource CinemaChrome}" Background="{DynamicResource SurfaceGradientBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,0,16,0" VerticalAlignment="Center">
                    <Image Source="Assets/parallax-studio-icon-256.png" Width="30" Height="30" Margin="0,0,11,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Parallax Studio" Style="{StaticResource TitleText}" ToolTip="{Binding AppTitle}" />
                    <Border Style="{StaticResource BadgeBorder}" Margin="12,0,0,0" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="CINEMA" Style="{StaticResource BadgeText}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Width="46" Height="34">
                        <ComboBox Style="{StaticResource TitleBarIconPicker}"
                                  ItemsSource="{Binding ThemeNames}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                  ToolTip="{Binding SelectedTheme}"
                                  AutomationProperties.Name="Studio theme" />
                        <TextBlock Text="&#xE790;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   IsHitTestVisible="False" />
                    </Grid>
                    <Grid Width="46" Height="34" Margin="7,0,0,0">
                        <ComboBox Style="{StaticResource TitleBarIconPicker}"
                                  ItemsSource="{Binding TypographyNames}"
                                  SelectedItem="{Binding SelectedTypography, Mode=TwoWay}"
                                  ToolTip="{Binding SelectedTypography}"
                                  AutomationProperties.Name="Typography profile" />
                        <TextBlock Text="Aa"
                                   FontFamily="{DynamicResource StudioDisplayFontFamily}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   IsHitTestVisible="False" />
                    </Grid>
                    <Button Content="&#xE713;" Style="{StaticResource IconButton}" Command="{Binding ToggleSettingsCommand}" Width="34" Height="34" Margin="7,0,0,0" ToolTip="Settings" AutomationProperties.Name="Open settings" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
                    <Button Content="" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore" />
                    <Button Content="" Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="20,18,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- HWND video cannot be rasterized by WPF effects or covered by WPF overlays. -->
            <Border x:Name="VideoBorder" Grid.Column="0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CinemaFrameBorder}">
                        <Setter Property="Margin" Value="0,0,14,0" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsCinemaSidebarHidden}" Value="True" />
                                    <Condition Binding="{Binding IsBluRayPanelOpen}" Value="False" />
                                    <Condition Binding="{Binding IsTracksPanelOpen}" Value="False" />
                                    <Condition Binding="{Binding IsSettingsPanelOpen}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Margin" Value="0" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                <Setter Property="Margin" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CinemaChrome}" Padding="20,17,20,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PARALLAX / CINEMA" Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="{Binding NowPlayingTitle}" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,6,12,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="&#xE700;" Style="{StaticResource IconButton}" Command="{Binding ToggleSidebarCommand}" ToolTip="Show or hide sidebar" AutomationProperties.Name="Toggle sidebar" Margin="0,0,8,0" />
                                <Button Content="" Style="{StaticResource IconButton}" Command="{Binding ToggleFullscreenCommand}" ToolTip="Fullscreen (F)" AutomationProperties.Name="Enter fullscreen" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="Black">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Margin" Value="8,8,8,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <interop:VideoSurfaceHost x:Name="VideoHost"
                                                      HandleCreated="VideoHost_HandleCreated"
                                                      DoubleClicked="VideoHost_DoubleClicked" />

                            <Border Visibility="{Binding EmptyStateVisibility}"
                                    Background="{DynamicResource SurfaceGradientBrush}"
                                    Padding="34"
                                    ClipToBounds="True">
                                <Grid>
                                    <Ellipse Width="520" Height="520"
                                             Stroke="{DynamicResource AccentBrush}"
                                             StrokeThickness="1"
                                             Opacity="0.055"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                    <Ellipse Width="360" Height="360"
                                             Stroke="{DynamicResource AccentSecondaryBrush}"
                                             StrokeThickness="1"
                                             Opacity="0.075"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="440">
                                        <Border Width="88" Height="88"
                                                Style="{StaticResource InsetBorder}"
                                                Padding="16"
                                                HorizontalAlignment="Center">
                                            <Image Source="Assets/parallax-studio-icon-256.png"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <TextBlock Text="PARALLAX / READY"
                                                   Style="{StaticResource EyebrowText}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,24,0,0" />
                                        <TextBlock Text="Your screening room is ready."
                                                   Style="{StaticResource HeadlineText}"
                                                   FontSize="25"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,9,0,0" />
                                        <TextBlock Text="Open a movie, drop a file anywhere in the window, or insert a Blu-ray or DVD."
                                                   Style="{StaticResource BodyText}"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,10,0,0" />
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,24,0,0">
                                            <Button Content="Open video"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding OpenCommand}"
                                                    MinWidth="132"
                                                    Margin="0,0,10,0"
                                                    AutomationProperties.Name="Open video" />
                                            <Button Content="Scan discs"
                                                    Style="{StaticResource CommandButton}"
                                                    Command="{Binding ScanDiscsCommand}"
                                                    MinWidth="118"
                                                    AutomationProperties.Name="Scan optical discs" />
                                        </StackPanel>
                                        <TextBlock Text="SPACE  Play / pause   •   F  Fullscreen   •   ← →  Seek"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="10"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,22,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CinemaChrome}" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SourceText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource BadgeBorder}" MaxWidth="220" ToolTip="{Binding BackendText}">
                                <TextBlock Text="{Binding BackendText}" Style="{StaticResource BadgeText}" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" Width="{DynamicResource StudioSidebarWidth}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0" Focusable="False">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBluRayPanelOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsTracksPanelOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSettingsPanelOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCinemaSidebarHidden}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Padding="{DynamicResource StudioSidebarCardPadding}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="NOW PLAYING" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource BadgeBorder}" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding NowPlayingStateText}" Style="{StaticResource BadgeText}" />
                                </Border>
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Height="112" Style="{StaticResource InsetBorder}" Padding="0" ClipToBounds="True" VerticalAlignment="Top">
                                    <Grid Background="{DynamicResource SurfaceGradientBrush}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Image Source="Assets/parallax-studio-icon-256.png" Width="34" Height="34" Opacity="0.55"/>
                                            <TextBlock Text="PARALLAX" FontSize="8" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <Image Source="{Binding Artwork}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Local media artwork"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="{Binding NowPlayingTitle}" FontFamily="{DynamicResource StudioDisplayFontFamily}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" MaxHeight="78" TextTrimming="CharacterEllipsis" ToolTip="{Binding NowPlayingTitle}"/>
                                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource BodyText}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" ToolTip="{Binding SourceLocation}"/>
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding MediaBadges}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Style="{StaticResource BadgeBorder}" Padding="7,4" Margin="0,0,5,5">
                                        <TextBlock Text="{Binding}" Style="{StaticResource BadgeText}" FontSize="9"/>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding NowPlayingProgress, Mode=OneWay}" Height="3" Margin="0,8,0,0" AutomationProperties.Name="Playback progress">
                                <ProgressBar.Template><ControlTemplate TargetType="ProgressBar">
                                    <Grid x:Name="PART_Track" Background="{DynamicResource BorderBrush}" ClipToBounds="True">
                                        <Border x:Name="PART_Indicator" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                                    </Grid>
                                </ControlTemplate></ProgressBar.Template>
                            </ProgressBar>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ProgressText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding RemainingText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0"/>
                            </Grid>
                            <Expander Header="Media details" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,16,0,0" AutomationProperties.Name="Media details">
                                <Border Style="{StaticResource InsetBorder}" Padding="11" Margin="0,9,0,0">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding MediaDetails}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding MetadataStatus}" FontSize="11" TextWrapping="Wrap">
                                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                <Style.Triggers><DataTrigger Binding="{Binding MetadataStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="{DynamicResource StudioSidebarCardPadding}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="YOUR SCREENING ROOM" Style="{StaticResource EyebrowText}" />
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenCommand}" Margin="0,14,0,10" ToolTip="Open a local video file">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Open video" />
                                </StackPanel>
                            </Button>
                            <UniformGrid Columns="2">
                                <Button Content="Tracks &amp; chapters" Style="{StaticResource CommandButton}" Command="{Binding ToggleTracksCommand}" Margin="0,0,5,0" Padding="8,9" FontSize="11" />
                                <Button Content="Fullscreen" Style="{StaticResource CommandButton}" Command="{Binding ToggleFullscreenCommand}" Margin="5,0,0,0" FontSize="11" />
                            </UniformGrid>
                            <TextBlock Text="Or drop a video into the window." Style="{StaticResource BodyText}" FontSize="11" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="{DynamicResource StudioSidebarCardPadding}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="OPTICAL MEDIA" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="From disc to screen" Style="{StaticResource BodyText}" FontSize="11" Margin="0,5,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Scan" Style="{StaticResource CommandButton}" Command="{Binding ScanDiscsCommand}" Padding="12,7" MinHeight="32" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Discs}" Margin="0,14,0,0" AutomationProperties.Name="Optical drives">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource InsetBorder}">
                                                    <Setter Property="Padding" Value="{DynamicResource StudioSidebarItemPadding}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding DriveRoot}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource BadgeBorder}" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding KindLabel}" Style="{StaticResource BadgeText}" />
                                                    </Border>
                                                </Grid>
                                                <Button Command="{Binding DataContext.PlayDiscCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,12,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CommandButton}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="Content" Value="Play disc" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsReady}" Value="True" />
                                                                        <Condition Binding="{Binding Kind}" Value="BluRay" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Content" Value="Play main feature" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsReady}" Value="True" />
                                                                        <Condition Binding="{Binding Kind}" Value="Dvd" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Content" Value="Play longest title" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="Browse titles" Command="{Binding DataContext.BrowseDiscTitlesCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,7,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CommandButton}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsReady}" Value="True" />
                                                                        <Condition Binding="{Binding Kind}" Value="BluRay" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsReady}" Value="True" />
                                                                        <Condition Binding="{Binding Kind}" Value="Dvd" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
