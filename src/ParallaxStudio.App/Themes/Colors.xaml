<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowColor">#09090B</Color>
    <Color x:Key="SurfaceColor">#0E0E12</Color>
    <Color x:Key="SurfaceRaisedColor">#15151B</Color>
    <Color x:Key="SurfaceHoverColor">#202028</Color>
    <Color x:Key="BorderColor">#303039</Color>
    <Color x:Key="BorderStrongColor">#555560</Color>
    <Color x:Key="TextColor">#F0F0F2</Color>
    <Color x:Key="TextSecondaryColor">#B8B8C0</Color>
    <Color x:Key="TextMutedColor">#7E7E89</Color>
    <Color x:Key="AccentColor">#E8E8EC</Color>
    <Color x:Key="AccentTextColor">#111114</Color>
    <Color x:Key="DangerColor">#D86B6B</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
</ResourceDictionary>
